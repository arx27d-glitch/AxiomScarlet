
#!/usr/bin/env bash

# ==========================================
#       AxiomMuzic Setup Installer V2
# ==========================================

set -Eeuo pipefail

# Colors
cred='\033[0;31m'
cgreen='\033[0;32m'
cyellow='\033[0;33m'
cblue='\033[0;34m'
cpurple='\033[0;35m'
cwhite='\033[0;37m'
creset='\033[0m'

# Logging
PY_LOG="pypilog.txt"
NODE_LOG="nodelog.txt"

touch "$PY_LOG" "$NODE_LOG"

pprint() {
    local message="${1:-}"
    local selected="${2:-cpurple}"
    local color="$cpurple"

    case "$selected" in
        cred) color="$cred" ;;
        cgreen) color="$cgreen" ;;
        cyellow) color="$cyellow" ;;
        cblue) color="$cblue" ;;
        cwhite) color="$cwhite" ;;
    esac

    printf '%b' "${color}${message}${creset}"
}

color_reset() {
    printf '%b' "$creset"
}

error_exit() {
    pprint "\n\nERROR: $1\n" "cred"
    pprint "Check pypilog.txt or nodelog.txt for details.\n" "cblue"
    exit 1
}

trap 'error_exit "Unexpected error on line $LINENO."' ERR

# ==========================================
# Helper Functions
# ==========================================

yesnoprompt() {
    local answer
    read -r -n 1 -s -p "" answer || true
    printf '\n'
    [[ "$answer" =~ ^[Yy]$ ]]
}

check_sudo() {
    pprint "\nChecking sudo privileges...\n" "cblue"

    if ! command -v sudo >/dev/null 2>&1; then
        error_exit "sudo is not installed."
    fi

    sudo -v || error_exit "Sudo permission required."
}

# ==========================================
# System Update
# ==========================================

update() {
    pprint "\nUpdating package list...\n" "cpurple"

    sudo apt-get update || error_exit "APT update failed."

    if sudo apt-get -s upgrade | grep -q '^Inst '; then
        pprint "\nUPDATE AVAILABLE\n" "cgreen"
        pprint "\nDo you want to upgrade packages (y/n)? " "cyellow"

        if yesnoprompt; then
            pprint "\nUpgrading packages...\n" "cpurple"

            sudo apt-get upgrade -y ||
                error_exit "Package upgrade failed."

            pprint "DONE!\n" "cgreen"
        fi
    else
        pprint "\nALREADY UP TO DATE\n" "cgreen"
    fi
}

# ==========================================
# Install System Packages
# ==========================================

packages() {
    pprint "\nInstalling system dependencies...\n" "cpurple"

    sudo apt-get install -y \
        curl \
        ca-certificates \
        python3 \
        python3-pip \
        python3-venv \
        ffmpeg \
        git \
        build-essential ||
        error_exit "System package installation failed."

    # FFmpeg verification
    if ! command -v ffmpeg >/dev/null 2>&1; then
        error_exit "FFmpeg installation failed."
    fi

    local ffmpeg_version
    ffmpeg_version=$(ffmpeg -version | head -n 1)

    pprint "\nFFmpeg detected: $ffmpeg_version\n" "cgreen"
}

# ==========================================
# Node.js Installation
# ==========================================

node() {
    if command -v node >/dev/null 2>&1 &&
       command -v npm >/dev/null 2>&1; then

        local node_version
        node_version=$(node -p 'process.versions.node.split(".")[0]')

        if (( node_version >= 22 )); then
            pprint "\nNode.js LTS already installed: $(node -v)\n" "cgreen"
            return
        fi
    fi

    pprint "\nInstalling Node.js 22 LTS and NPM...\n" "cpurple"

    if ! curl -fsSL https://deb.nodesource.com/setup_22.x |
        sudo -E bash - >>"$NODE_LOG" 2>&1; then
        error_exit "Node.js repository setup failed."
    fi

    if ! sudo apt-get install -y nodejs >>"$NODE_LOG" 2>&1; then
        error_exit "Node.js installation failed."
    fi

    command -v node >/dev/null ||
        error_exit "Node.js command not found."

    command -v npm >/dev/null ||
        error_exit "NPM command not found."

    pprint "Node.js: $(node -v)\n" "cgreen"
    pprint "NPM: $(npm -v)\n" "cgreen"
}

# ==========================================
# Python Dependencies
# ==========================================

installation() {
    pprint "\nSetting up Python virtual environment...\n" "cpurple"

    if [[ ! -f requirements.txt ]]; then
        error_exit "requirements.txt not found in current directory."
    fi

    if [[ ! -d .venv ]]; then
        python3 -m venv .venv ||
            error_exit "Virtual environment creation failed."
    fi

    local PYTHON=".venv/bin/python"
    local PIP=".venv/bin/pip"

    pprint "\nUpgrading pip...\n" "cpurple"

    "$PYTHON" -m pip install --upgrade pip \
        >>"$PY_LOG" 2>&1 ||
        error_exit "Pip upgrade failed."

    pprint "\nInstalling requirements...\n" "cpurple"

    "$PIP" install -U -r requirements.txt \
        >>"$PY_LOG" 2>&1 ||
        error_exit "Python dependency installation failed."

    pprint "\nPython dependencies installed successfully!\n" "cgreen"
}

# ==========================================
# Environment Input
# ==========================================

get_variables() {
    pprint "\n\nEnter Your Configuration Values\n\n" "cgreen"

    read -r -p "API ID: " api_id
    read -r -p "API HASH: " api_hash

    read -r -s -p "BOT TOKEN: " bot_token
    printf '\n'

    read -r -p "OWNER ID: " ownid
    read -r -p "MONGO DB URI: " mongo_db
    read -r -p "LOG GROUP ID: " logger

    read -r -s -p "STRING SESSION: " string_session
    printf '\n'

    # Validate required values
    [[ "$api_id" =~ ^[0-9]+$ ]] ||
        error_exit "Invalid API ID."

    [[ -n "$api_hash" ]] ||
        error_exit "API HASH cannot be empty."

    [[ -n "$bot_token" ]] ||
        error_exit "BOT TOKEN cannot be empty."

    [[ "$ownid" =~ ^-?[0-9]+$ ]] ||
        error_exit "Invalid OWNER ID."

    [[ -n "$mongo_db" ]] ||
        error_exit "Mongo DB URI cannot be empty."

    [[ "$logger" =~ ^-?[0-9]+$ ]] ||
        error_exit "Invalid LOG GROUP ID."

    [[ -n "$string_session" ]] ||
        error_exit "STRING SESSION cannot be empty."
}

# ==========================================
# Create .env Safely
# ==========================================

create_env() {
    pprint "\nSaving configuration...\n" "cpurple"

    # Backup existing .env
    if [[ -f .env ]]; then
        local backup=".env.backup.$(date +%Y%m%d_%H%M%S)"

        cp -p .env "$backup" ||
            error_exit "Could not backup existing .env."

        pprint "Existing .env backup: $backup\n" "cgreen"
    fi

    export API_ID="$api_id"
    export API_HASH="$api_hash"
    export BOT_TOKEN="$bot_token"
    export MONGO_DB_URI="$mongo_db"
    export LOGGER_ID="$logger"
    export STRING_SESSION="$string_session"
    export OWNER_ID="$ownid"

    # JSON quoted values are compatible with python-dotenv.
    python3 - <<'PY'
import json
import os

keys = [
    "API_ID",
    "API_HASH",
    "BOT_TOKEN",
    "MONGO_DB_URI",
    "LOGGER_ID",
    "STRING_SESSION",
    "OWNER_ID",
]

with open(".env", "w", encoding="utf-8") as file:
    for key in keys:
        value = os.environ.get(key, "")
        file.write(f"{key}={json.dumps(value, ensure_ascii=False)}\n")
PY

    chmod 600 .env ||
        error_exit "Could not secure .env permissions."

    unset API_ID API_HASH BOT_TOKEN MONGO_DB_URI
    unset LOGGER_ID STRING_SESSION OWNER_ID

    pprint ".env created successfully!\n" "cgreen"
}

# ==========================================
# Main Installer
# ==========================================

main() {
    if [[ -t 1 ]]; then
        clear || true
    fi

    pprint "Welcome to AxiomMuzic Setup Installer V2\n\n"
    pprint "Installation logs:\n" "cblue"
    pprint "Python errors: pypilog.txt\n"
    pprint "Node.js errors: nodelog.txt\n"

    sleep 1

    check_sudo
    update
    packages
    node
    installation

    pprint "\n\nAxiomMuzic Dependencies Installed!\n" "cgreen"

    get_variables
    create_env

    if [[ -t 1 ]]; then
        clear || true
    fi

    pprint "\n\n====================================\n" "cgreen"
    pprint " AxiomMuzic Installation Completed!\n" "cgreen"
    pprint "====================================\n" "cgreen"

    pprint "\nYour configuration has been saved successfully.\n" "cgreen"

    pprint "\nTo start your bot, use:\n" "cblue"
    pprint "bash start\n\n" "cgreen"

    pprint "To activate Python virtual environment manually:\n" "cblue"
    pprint "source .venv/bin/activate\n\n" "cgreen"
}

main "$@"
